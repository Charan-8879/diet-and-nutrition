# ==============================================================================
# Healthify AI Diet & Fitness Tracking Platform - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000

# CORS Configuration (comma-separated origins or * in production)
# e.g., https://diet-and-nutrition.vercel.app,http://localhost:3000
CORS_ORIGIN=https://diet-and-nutrition.vercel.app

# Database Configuration (TiDB Cloud Starter / MySQL)
# For TiDB Cloud Starter:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=3XZoHxRta5AerHn.root
# DB_NAME=healthify_db
# DB_PASSWORD=<your_tidb_cloud_password>
# DB_SSL=true
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=3XZoHxRta5AerHn.root
DB_PASSWORD=
DB_NAME=healthify_db
DB_SSL=true
DB_CONNECTION_LIMIT=10

# GroqCloud AI Health Coach & Computer Vision Configuration
# Obtain your key from https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
